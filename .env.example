# Public URL of the deployed site (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://my-portfolio-umber-ten-96.vercel.app
# NestJS backend base URL (GraphQL lives at /graphql)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
CONTACT_FORM_TO=you@example.com
# Optional: a sender on a domain you verified in Resend
CONTACT_FORM_FROM=

# Unit-7 AI tour guide (https://console.anthropic.com). Optional: without a key
# the assistant runs the scripted tour in "offline mode".
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
ANTHROPIC_MODEL=
